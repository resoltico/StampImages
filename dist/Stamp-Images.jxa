const CAT = "/bin/cat";
const CMP = "/usr/bin/cmp";
const CP = "/bin/cp";
const LN = "/bin/ln";
const MKDIR = "/bin/mkdir";
const MV = "/bin/mv";
const RM = "/bin/rm";
const RMDIR = "/bin/rmdir";
const TEST = "/bin/test";
const MKTEMP = "/usr/bin/mktemp";
const PRINTENV = "/usr/bin/printenv";
